          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
